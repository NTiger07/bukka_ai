{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "NVIDIA_MODEL": "nvidia/nemotron-3-ultra-550b-a55b",
    "REVIEW_SAMPLE_LIMIT": "10000",
    "ALLOWED_ORIGINS": "https://bukkaai.vercel.app"
  }
}
