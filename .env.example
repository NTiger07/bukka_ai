ANTHROPIC_API_KEY=sk-ant-...

# Path to Yelp dataset directory (relative to project root)
YELP_DATA_DIR=yelp_dataset

# How many reviews to index at startup for few-shot examples.
# Lower = faster startup, less variety in examples. 100k is a good balance.
REVIEW_SAMPLE_LIMIT=10000

# Claude model to use
CLAUDE_MODEL=claude-haiku-4-5-20251001
